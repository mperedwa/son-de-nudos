{
  "name": "son-de-nudos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "security:scan": "bash scripts/check-no-secrets.sh",
    "preview": "vite preview",
    "migrate": "tsx --env-file=.env scripts/migrate-to-supabase.ts",
    "migrate:dry": "tsx --env-file=.env scripts/migrate-to-supabase.ts --dry-run --verbose",
    "setup:admin": "tsx --env-file=.env scripts/setup-admin-user.ts",
    "create:admin": "tsx --env-file=.env scripts/create-admin.ts",
    "generate:template": "tsx --env-file=.env scripts/generate-template.ts",
    "import:products": "tsx --env-file=.env scripts/import-from-excel.ts",
    "import:dry": "tsx --env-file=.env scripts/import-from-excel.ts --dry"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@stripe/stripe-js": "^8.4.0",
    "@supabase/supabase-js": "^2.81.1",
    "clsx": "^2.1.1",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.66.0",
    "react-i18next": "^16.3.3",
    "react-phone-number-input": "^3.4.14",
    "react-router-dom": "^7.9.6",
    "stripe": "^19.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/node": "^5.5.13",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.24",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  }
}
