# Son de Nudos - Variables de Entorno
# Copia este archivo a .env y completa los valores reales

# ==================================
# STRIPE (Modo Stripe Checkout)
# ==================================
# Obtén tus claves en: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Webhook Secret (para verificar eventos de Stripe)
# Obtenerlo en: https://dashboard.stripe.com/webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# ==================================
# SHOPIFY (Modo Shopify Storefront)
# ==================================
# Obtén tu token en: Admin → Apps → Develop apps → Create an app → Storefront API access token
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# ==================================
# CONFIGURACIÓN GENERAL
# ==================================
# Modo de datos: mock | stripe | shopify
VITE_DATA_MODE=mock

# Moneda por defecto
VITE_CURRENCY=USD

# Costo de envío estándar (en USD)
VITE_SHIPPING_COST=10

# Umbral de envío gratis (en USD)
VITE_FREE_SHIPPING_THRESHOLD=150

# ==================================
# SUPABASE (Fase 11: Panel Admin)
# ==================================
# Obtén tus credenciales en: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Copias exclusivas del backend para funciones serverless
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service Role Key (SOLO PARA BACKEND - NO EXPONER EN CLIENTE)
SUPABASE_SERVICE_ROLE_KEY=

# Herramientas locales de administración (NO configurar en Vercel)
SUPABASE_DB_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_USER_ID=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# ==================================
# APLICACIÓN
# ==================================
# URL de producción (dominio personalizado)
VITE_APP_URL=https://www.sondenudos.com

# ==================================
# VERCEL CRON JOBS (Supabase Keepalive)
# ==================================
# Secret para autenticar llamadas del cron job
# Generar con: openssl rand -base64 32
# Configurar en Vercel: Dashboard → Settings → Environment Variables
CRON_SECRET=

# ==================================
# GOOGLE PLACES (Autocompletado de direcciones)
# ==================================
# Obtén tu API key en: https://console.cloud.google.com/
# 1. Crea un proyecto o usa existente
# 2. Habilita "Places API" y "Maps JavaScript API"
# 3. Crea una API Key en "Credentials"
# 4. Configura restricciones HTTP referrer: www.sondenudos.com/*, localhost:5174/*
VITE_GOOGLE_PLACES_API_KEY=

# ==================================
# DESARROLLO
# ==================================
# Puerto del servidor de desarrollo (PERMANENTE: 5174 para Son de Nudos)
VITE_PORT=5174
